@using LGS.Tech.Models
@model OrdenReparacion

@{
    ViewData["Title"] = $"Orden #{Model.Id}";


    var pagos =
        ViewBag.Pagos as List<Pago> ?? new List<Pago>();

    decimal totalPagado =
        ViewBag.TotalPagado != null
            ? (decimal)ViewBag.TotalPagado
            : 0m;
    decimal? saldoEstimado =
    ViewBag.SaldoEstimado != null
        ? (decimal?)ViewBag.SaldoEstimado
        : null;

    var archivos =
    ViewBag.Archivos as List<ArchivoOrden>
    ?? new List<ArchivoOrden>();    

}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Orden de reparación #@Model.Id</h2>

            <p class="text-muted mb-0">
                Ingresada el
                @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <div class="d-flex gap-2">

            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="OrdenesReparacion" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">
                    Editar
                </a>
            }

            @if (User.IsInRole("Tecnico") &&
                 !User.IsInRole("Administrador"))
            {
                <a asp-controller="OrdenesReparacion" asp-action="ActualizarTrabajo" asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Actualizar trabajo
                </a>
            }

            <a asp-controller="OrdenesReparacion" asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </div>
        
    </div>
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- ESTADO -->
    <div class="mb-3">

        @switch (Model.Estado)
        {
            case EstadoOrden.Pendiente:

                <span class="badge bg-warning text-dark fs-6">
                    Pendiente
                </span>

                break;

            case EstadoOrden.EnReparacion:

                <span class="badge bg-primary fs-6">
                    En reparación
                </span>

                break;

            case EstadoOrden.Reparado:

                <span class="badge bg-success fs-6">
                    Reparado
                </span>

                break;

            case EstadoOrden.Entregado:

                <span class="badge bg-secondary fs-6">
                    Entregado
                </span>

                break;
        }

    </div>

    <div class="row">

        <!-- CLIENTE -->
        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-header">
                    <strong>Cliente</strong>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Nombre:</strong>
                        @Model.Equipo.Cliente.Nombre
                        @Model.Equipo.Cliente.Apellido
                    </p>

                    <p>
                        <strong>Documento:</strong>
                        @Model.Equipo.Cliente.Documento
                    </p>

                    <p>
                        <strong>Teléfono:</strong>
                        @Model.Equipo.Cliente.Telefono
                    </p>

                    <p class="mb-0">
                        <strong>Correo:</strong>

                        @if (!string.IsNullOrWhiteSpace(Model.Equipo.Cliente.Correo))
                        {
                            @Model.Equipo.Cliente.Correo
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }
                    </p>

                </div>

            </div>

        </div>

        <!-- EQUIPO -->
        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-header">
                    <strong>Equipo</strong>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Tipo:</strong>
                        @Model.Equipo.Tipo
                    </p>

                    <p>
                        <strong>Marca:</strong>
                        @Model.Equipo.Marca
                    </p>

                    <p>
                        <strong>Modelo:</strong>
                        @Model.Equipo.Modelo
                    </p>

                    <p class="mb-0">
                        <strong>N° de serie:</strong>

                        @if (!string.IsNullOrWhiteSpace(Model.Equipo.NumeroSerie))
                        {
                            @Model.Equipo.NumeroSerie
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- REPARACION -->
    <div class="card mb-3">

        <div class="card-header">
            <strong>Reparación</strong>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>Problema informado</strong>

                <p class="mt-1 mb-0">
                    @Model.Problema
                </p>
            </div>

            <hr />

            <div class="mb-0">
                <strong>Diagnóstico</strong>

                @if (!string.IsNullOrWhiteSpace(Model.Diagnostico))
                {
                    <p class="mt-1 mb-0">
                        @Model.Diagnostico
                    </p>
                }
                else
                {
                    <p class="text-muted mt-1 mb-0">
                        Todavía no se registró un diagnóstico.
                    </p>
                }

            </div>

        </div>

    </div>

    <div class="row">

        <!-- TECNICO -->
        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-header">
                    <strong>Técnico</strong>
                </div>

                <div class="card-body">

                    @if (Model.Tecnico != null)
                    {
                        <p>
                            <strong>Nombre:</strong>
                            @Model.Tecnico.Nombre
                            @Model.Tecnico.Apellido
                        </p>

                        <p class="mb-0">
                            <strong>Correo:</strong>
                            @Model.Tecnico.Email
                        </p>
                    }
                    else
                    {
                        <span class="text-muted">
                            Sin técnico asignado.
                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- DATOS -->
        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-header">
                    <strong>Datos de la orden</strong>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Fecha de ingreso:</strong>
                        @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Fecha de finalización:</strong>

                        @if (Model.FechaFinalizacion.HasValue)
                        {
                            @Model.FechaFinalizacion.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin finalizar
                            </span>
                        }
                    </p>

                    <p class="mb-0">
                        <strong>Costo estimado:</strong>

                        @if (Model.CostoEstimado.HasValue)
                        {
                            <span>
                                $ @Model.CostoEstimado.Value.ToString("N2")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No definido
                            </span>
                        }
                    </p>

                </div>

            </div>

        </div>

    </div>
    <!-- ====================================== -->
    <!-- PAGOS -->
    <!-- ====================================== -->

    <div class="card mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>Pagos</strong>

            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Pagos" asp-action="Registrar" asp-route-ordenId="@Model.Id"
                   class="btn btn-sm btn-primary">
                    Registrar pago
                </a>
            }

        </div>

        <div class="card-body">

            @if (pagos.Count == 0)
            {
                <div class="alert alert-info mb-3">
                    Todavía no se registraron pagos para esta orden.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Método</th>
                                <th>Observación</th>
                                <th class="text-end">Monto</th>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var pago in pagos)
                            {
                                <tr>

                                    <td>
                                        @pago.FechaPago.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>

                                    <td>
                                        @pago.TipoPago
                                    </td>

                                    <td>
                                        @pago.MetodoPago
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            pago.Observacion))
                                        {
                                            @pago.Observacion
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        $ @pago.Monto.ToString("N2")
                                    </td>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <td class="text-end">

                                            <form asp-controller="Pagos" asp-action="Eliminar" asp-route-id="@pago.Id" method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Seguro que desea eliminar este pago?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            <hr />

            <div class="d-flex justify-content-end">

                <div class="text-end">

                    <div class="mb-2">

                        <div class="text-muted">
                            Total pagado
                        </div>

                        <div class="fs-4 fw-bold">
                            $ @totalPagado.ToString("N2")
                        </div>

                    </div>

                    @if (saldoEstimado.HasValue)
                    {
                        if (saldoEstimado.Value >= 0)
                        {
                            <div>
                                <div class="text-muted">
                                    Saldo estimado pendiente
                                </div>

                                <div class="fs-5 fw-bold">
                                    $ @saldoEstimado.Value.ToString("N2")
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="text-muted">
                                    Excedente sobre costo estimado
                                </div>

                                <div class="fs-5 fw-bold">
                                    $ @Math.Abs(saldoEstimado.Value).ToString("N2")
                                </div>
                                </div>
                        }
                        }

                          </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
<!-- ====================================== -->
<!-- ARCHIVOS -->
<!-- ====================================== -->

<div class="card mb-3">

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Archivos / Evidencias</strong>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="ArchivosOrden" asp-action="Subir" asp-route-ordenId="@Model.Id"
               class="btn btn-sm btn-primary">
                Subir archivo
            </a>
        }

    </div>

    <div class="card-body">

        @if (archivos.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Todavía no se subieron archivos para esta orden.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var archivo in archivos)
                        {
                            <tr>

                                <td>
                                    @archivo.NombreArchivo
                                </td>

                                <td>
                                    @archivo.TipoArchivo
                                </td>

                                <td>
                                    @archivo.FechaSubida.ToString(
                                        "dd/MM/yyyy HH:mm"
                                    )
                                </td>

                                <td class="text-end">

                                    <a asp-controller="ArchivosOrden" asp-action="Abrir" asp-route-id="@archivo.Id"
                                       target="_blank" class="btn btn-sm btn-info">
                                        Abrir
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <form asp-controller="ArchivosOrden" asp-action="Eliminar" asp-route-id="@archivo.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('¿Seguro que desea eliminar este archivo?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

</div>