@using LGS.Tech.Models
@model List<OrdenReparacion>

@{
    ViewData["Title"] = "Órdenes de reparación";

    string? buscar = ViewBag.Buscar;

    EstadoOrden? estado =
        ViewBag.Estado == null
            ? null
            : (EstadoOrden)ViewBag.Estado;

    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int totalRegistros = ViewBag.TotalRegistros;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Órdenes de reparación</h2>

            <p class="text-muted mb-0">
                Total registradas: @totalRegistros
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="OrdenesReparacion"
               asp-action="Crear"
               class="btn btn-primary">
                Nueva orden
            </a>
        }

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- BUSQUEDA Y FILTRO -->
    <div class="card mb-3">

        <div class="card-body">

            <form method="get"
                  asp-controller="OrdenesReparacion"
                  asp-action="Index">

                <div class="row g-2">

                    <div class="col-md-6">

                        <input type="text"
                               name="buscar"
                               value="@buscar"
                               class="form-control"
                               placeholder="Buscar por cliente, equipo, problema..." />

                    </div>

                    <div class="col-md-3">

                        <select name="estado"
                                class="form-select">

                            <option value="">
                                Todos los estados
                            </option>

                            @foreach (var opcion in Enum.GetValues<EstadoOrden>())
                            {
                                if (estado == opcion)
                                {
                                    <option value="@opcion" selected>
                                        @opcion
                                    </option>
                                }
                                else
                                {
                                    <option value="@opcion">
                                        @opcion
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Buscar
                        </button>

                        <a asp-controller="OrdenesReparacion"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLA -->
    <div class="card">

        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No hay órdenes de reparación registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Equipo</th>
                                <th>Técnico</th>
                                <th>Problema</th>
                                <th>Estado</th>
                                <th>Ingreso</th>
                                <th class="text-end">
                                    Acciones
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var orden in Model)
                            {
                                <tr>

                                    <td>
                                        @orden.Id
                                    </td>

                                    <td>
                                        @orden.Equipo.Cliente.Nombre
                                        @orden.Equipo.Cliente.Apellido
                                    </td>

                                    <td>
                                        <strong>
                                            @orden.Equipo.Marca
                                            @orden.Equipo.Modelo
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @orden.Equipo.Tipo
                                        </small>
                                    </td>

                                    <td>

                                        @if (orden.Tecnico != null)
                                        {
                                            <span>
                                                @orden.Tecnico.Nombre
                                                @orden.Tecnico.Apellido
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin asignar
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @orden.Problema
                                    </td>

                                    <td>

                                        @switch (orden.Estado)
                                        {
                                            case EstadoOrden.Pendiente:

                                                <span class="badge bg-warning text-dark">
                                                    Pendiente
                                                </span>

                                                break;

                                            case EstadoOrden.EnReparacion:

                                                <span class="badge bg-primary">
                                                    En reparación
                                                </span>

                                                break;

                                            case EstadoOrden.Reparado:

                                                <span class="badge bg-success">
                                                    Reparado
                                                </span>

                                                break;

                                            case EstadoOrden.Entregado:

                                                <span class="badge bg-secondary">
                                                    Entregado
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>
                                        @orden.FechaIngreso.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="OrdenesReparacion"
                                           asp-action="Detalle"
                                           asp-route-id="@orden.Id"
                                           class="btn btn-sm btn-info">
                                            Ver
                                        </a>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-controller="OrdenesReparacion"
                                               asp-action="Editar"
                                               asp-route-id="@orden.Id"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- PAGINACION -->
    @if (totalPaginas > 1)
    {
        <nav class="mt-3">

            <ul class="pagination">

                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="OrdenesReparacion"
                       asp-action="Index"
                       asp-route-buscar="@buscar"
                       asp-route-estado="@estado"
                       asp-route-pagina="@(paginaActual - 1)">
                        Anterior
                    </a>

                </li>

                <li class="page-item disabled">

                    <span class="page-link">
                        Página @paginaActual de @totalPaginas
                    </span>

                </li>

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="OrdenesReparacion"
                       asp-action="Index"
                       asp-route-buscar="@buscar"
                       asp-route-estado="@estado"
                       asp-route-pagina="@(paginaActual + 1)">
                        Siguiente
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>