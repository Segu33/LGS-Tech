@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4" id="appClientes">

    @Html.AntiForgeryToken()

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Clientes</h2>

        <button class="btn btn-primary"
                v-on:click="abrirFormulario">
            Nuevo cliente
        </button>
    </div>

    <!-- Mensaje general -->
    <div v-if="mensaje"
         class="alert"
         v-bind:class="mensajeExito ? 'alert-success' : 'alert-danger'">

        {{ mensaje }}
    </div>

    <!-- Formulario Crear / Editar -->
    <div v-if="mostrarFormulario"
         class="card mb-4">

        <div class="card-header">
            {{ modoEdicion ? "Editar cliente" : "Nuevo cliente" }}
        </div>

        <div class="card-body">

            <form v-on:submit.prevent="guardarCliente">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Nombre
                        </label>

                        <input type="text"
                               class="form-control"
                               v-model="formulario.nombre"
                               maxlength="60"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Apellido
                        </label>

                        <input type="text"
                               class="form-control"
                               v-model="formulario.apellido"
                               maxlength="60"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Documento
                        </label>

                        <input type="text"
                               class="form-control"
                               v-model="formulario.documento"
                               maxlength="20"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Teléfono
                        </label>

                        <input type="text"
                               class="form-control"
                               v-model="formulario.telefono"
                               maxlength="30"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Correo
                        </label>

                        <input type="email"
                               class="form-control"
                               v-model="formulario.correo"
                               maxlength="100" />
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-success me-2"
                        v-bind:disabled="guardando">

                    {{
                        guardando
                            ? "Guardando..."
                            : (modoEdicion ? "Actualizar" : "Guardar")
                    }}

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        v-on:click="cancelarFormulario"
                        v-bind:disabled="guardando">
                    Cancelar
                </button>

            </form>

        </div>
    </div>

    <!-- Buscador -->
    <form class="row mb-4"
          v-on:submit.prevent="buscarClientes">

        <div class="col-md-8">
            <input type="text"
                   class="form-control"
                   v-model="buscar"
                   placeholder="Buscar por nombre, apellido o documento..." />
        </div>

        <div class="col-md-4">

            <button type="submit"
                    class="btn btn-primary me-2">
                Buscar
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    v-on:click="limpiarBusqueda">
                Limpiar
            </button>

        </div>

    </form>

    <!-- Cargando -->
    <div v-if="cargando"
         class="alert alert-info">
        Cargando clientes...
    </div>

    <!-- Error -->
    <div v-if="error"
         class="alert alert-danger">
        {{ error }}
    </div>

    <!-- Sin clientes -->
    <div v-if="!cargando && clientes.length === 0 && !error"
         class="alert alert-info">
        No hay clientes registrados.
    </div>

    <!-- Tabla -->
    <div v-if="clientes.length > 0">

        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Documento</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                <tr v-for="cliente in clientes"
                    v-bind:key="cliente.id">

                    <td>{{ cliente.nombre }}</td>

                    <td>{{ cliente.apellido }}</td>

                    <td>{{ cliente.documento }}</td>

                    <td>{{ cliente.telefono }}</td>

                    <td>
                        {{ cliente.correo || "-" }}
                    </td>

                    <td>

                        <button class="btn btn-sm btn-warning me-1"
                                v-on:click="editarCliente(cliente)">
                            Editar
                        </button>

                        <button class="btn btn-sm btn-danger" v-on:click="eliminarCliente(cliente)">
                            Eliminar
                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

        <!-- Información -->
        <div class="mb-2">
            Total de clientes: {{ totalRegistros }}
        </div>

        <!-- Paginación -->
        <div class="d-flex justify-content-between align-items-center">

            <button class="btn btn-outline-primary"
                    v-on:click="cambiarPagina(paginaActual - 1)"
                    v-bind:disabled="paginaActual <= 1">
                Anterior
            </button>

            <span>
                Página {{ paginaActual }} de {{ totalPaginas }}
            </span>

            <button class="btn btn-outline-primary"
                    v-on:click="cambiarPagina(paginaActual + 1)"
                    v-bind:disabled="
                        paginaActual >= totalPaginas ||
                        totalPaginas === 0">
                Siguiente
            </button>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>

        const { createApp } = Vue;

        createApp({

            data() {

                return {

                    clientes: [],

                    buscar: "",

                    paginaActual: 1,
                    totalPaginas: 0,
                    totalRegistros: 0,
                    cantidadPorPagina: 10,

                    cargando: false,
                    error: "",

                    mostrarFormulario: false,
                    modoEdicion: false,
                    guardando: false,

                    mensaje: "",
                    mensajeExito: false,

                    formulario: {
                        id: 0,
                        nombre: "",
                        apellido: "",
                        documento: "",
                        telefono: "",
                        correo: ""
                    }
                };
            },

            methods: {

                async cargarClientes() {

                    this.cargando = true;
                    this.error = "";

                    try {

                        const parametros = new URLSearchParams({
                            buscar: this.buscar,
                            pagina: this.paginaActual,
                            cantidadPorPagina: this.cantidadPorPagina
                        });

                        const respuesta = await fetch(
                            `/Clientes/Listar?${parametros}`
                        );

                        if (!respuesta.ok) {

                            throw new Error(
                                "No se pudieron cargar los clientes."
                            );
                        }

                        const datos = await respuesta.json();

                        this.clientes = datos.clientes;
                        this.paginaActual = datos.paginaActual;
                        this.totalPaginas = datos.totalPaginas;
                        this.totalRegistros = datos.totalRegistros;

                    }
                    catch (error) {

                        console.error(error);

                        this.error =
                            "Ocurrió un error al cargar los clientes.";

                    }
                    finally {

                        this.cargando = false;
                    }
                },

                buscarClientes() {

                    this.paginaActual = 1;

                    this.cargarClientes();
                },

                limpiarBusqueda() {

                    this.buscar = "";
                    this.paginaActual = 1;

                    this.cargarClientes();
                },

                cambiarPagina(pagina) {

                    if (
                        pagina < 1 ||
                        pagina > this.totalPaginas
                    ) {
                        return;
                    }

                    this.paginaActual = pagina;

                    this.cargarClientes();
                },

                abrirFormulario() {

                    this.mensaje = "";
                    this.modoEdicion = false;

                    this.formulario = {
                        id: 0,
                        nombre: "",
                        apellido: "",
                        documento: "",
                        telefono: "",
                        correo: ""
                    };

                    this.mostrarFormulario = true;
                },

                editarCliente(cliente) {

                    this.mensaje = "";
                    this.modoEdicion = true;

                    this.formulario = {
                        id: cliente.id,
                        nombre: cliente.nombre,
                        apellido: cliente.apellido,
                        documento: cliente.documento,
                        telefono: cliente.telefono,
                        correo: cliente.correo || ""
                    };

                    this.mostrarFormulario = true;

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });
                },

                cancelarFormulario() {

                    this.mostrarFormulario = false;
                    this.modoEdicion = false;
                    this.mensaje = "";
                },

                async guardarCliente() {

                    if (this.modoEdicion) {

                        await this.actualizarCliente();

                    }
                    else {

                        await this.crearCliente();
                    }
                },

                async crearCliente() {

                    this.guardando = true;
                    this.mensaje = "";

                    try {

                        const token = document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                        const respuesta = await fetch(
                            "/Clientes/Crear",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify(this.formulario)
                            }
                        );

                        const datos = await respuesta.json();

                        if (!respuesta.ok) {

                            this.mensajeExito = false;

                            this.mensaje =
                                datos.mensaje ||
                                "No se pudo crear el cliente.";

                            return;
                        }

                        this.mensajeExito = true;
                        this.mensaje = datos.mensaje;

                        this.mostrarFormulario = false;

                        this.paginaActual = 1;

                        await this.cargarClientes();

                    }
                    catch (error) {

                        console.error(error);

                        this.mensajeExito = false;

                        this.mensaje =
                            "Ocurrió un error al crear el cliente.";

                    }
                    finally {

                        this.guardando = false;
                    }
                },

                async actualizarCliente() {

                    this.guardando = true;
                    this.mensaje = "";

                    try {

                        const token = document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                        const respuesta = await fetch(
                            `/Clientes/Editar?id=${this.formulario.id}`,
                            {
                                method: "PUT",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify(this.formulario)
                            }
                        );

                        const datos = await respuesta.json();

                        if (!respuesta.ok) {

                            this.mensajeExito = false;

                            this.mensaje =
                                datos.mensaje ||
                                "No se pudo actualizar el cliente.";

                            return;
                        }

                        this.mensajeExito = true;
                        this.mensaje = datos.mensaje;

                        this.mostrarFormulario = false;
                        this.modoEdicion = false;

                        await this.cargarClientes();

                    }
                    catch (error) {

                        console.error(error);

                        this.mensajeExito = false;

                        this.mensaje =
                            "Ocurrió un error al actualizar el cliente.";

                    }
                    finally {

                        this.guardando = false;
                    }
                },

                async eliminarCliente(cliente) {

                    const confirmado = confirm(
                        `¿Seguro que desea eliminar a ${cliente.nombre} ${cliente.apellido}?`
                    );

                    if (!confirmado) {
                        return;
                    }

                    this.mensaje = "";

                    try {

                        const token = document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                        const respuesta = await fetch(
                            `/Clientes/Eliminar?id=${cliente.id}`,
                            {
                                method: "DELETE",

                                headers: {
                                    "RequestVerificationToken": token
                                }
                            }
                        );

                        const datos = await respuesta.json();

                        if (!respuesta.ok) {

                            this.mensajeExito = false;

                            this.mensaje =
                                datos.mensaje ||
                                "No se pudo eliminar el cliente.";

                            return;
                        }

                        this.mensajeExito = true;
                        this.mensaje = datos.mensaje;

                        await this.cargarClientes();

                        // Si eliminamos el último registro de una página,
                        // volvemos a la página anterior.
                        if (
                            this.clientes.length === 0 &&
                            this.paginaActual > 1
                        ) {
                            this.paginaActual--;

                            await this.cargarClientes();
                        }

                    }
                    catch (error) {

                        console.error(error);

                        this.mensajeExito = false;

                        this.mensaje =
                            "Ocurrió un error al eliminar el cliente.";
                    }
                }

            },

            mounted() {

                this.cargarClientes();
            }

        }).mount("#appClientes");

    </script>
}