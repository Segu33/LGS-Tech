@model List<LGS.Tech.ViewModels.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Usuarios</h2>

            <p class="text-muted mb-0">
                Administración de usuarios del sistema
            </p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Crear"
           class="btn btn-primary">
            Nuevo usuario
        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card">

        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No hay usuarios registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-end">
                                    Acciones
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var usuario in Model)
                            {
                                <tr>

                                    <td>
                                        @usuario.Nombre
                                    </td>

                                    <td>
                                        @usuario.Apellido
                                    </td>

                                    <td>
                                        @usuario.Email
                                    </td>

                                    <td>

                                        @if (usuario.Rol == "Administrador")
                                        {
                                            <span class="badge bg-danger">
                                                Administrador
                                            </span>
                                        }
                                        else if (usuario.Rol == "Tecnico")
                                        {
                                            <span class="badge bg-primary">
                                                Técnico
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @usuario.Rol
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Usuarios"
                                           asp-action="Editar"
                                           asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>
                                        <a asp-controller="Usuarios" asp-action="CambiarPassword" asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-secondary">
                                            Contraseña
                                        </a>
                                        <a asp-controller="Usuarios" asp-action="CambiarAvatar" asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-info">
                                            Avatar
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>