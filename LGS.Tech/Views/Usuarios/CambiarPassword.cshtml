@model LGS.Tech.ViewModels.UsuarioPasswordViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Cambiar contraseña</h2>

            <p class="text-muted mb-0">
                Usuario: @Model.NombreUsuario
            </p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

    </div>

    <div class="card">

        <div class="card-body">

            <form asp-controller="Usuarios"
                  asp-action="CambiarPassword"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <input asp-for="NombreUsuario"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- NUEVA CONTRASEÑA -->
                <div class="mb-3">

                    <label asp-for="NuevaPassword"
                           class="form-label">
                        Nueva contraseña
                    </label>

                    <input asp-for="NuevaPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="NuevaPassword"
                          class="text-danger">
                    </span>

                </div>

                <!-- CONFIRMAR CONTRASEÑA -->
                <div class="mb-3">

                    <label asp-for="ConfirmarPassword"
                           class="form-label">
                        Confirmar nueva contraseña
                    </label>

                    <input asp-for="ConfirmarPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmarPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="alert alert-warning">
                    Al guardar, la contraseña anterior dejará de ser válida.
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Actualizar contraseña
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}