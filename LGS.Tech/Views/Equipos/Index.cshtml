@model List<LGS.Tech.Models.Equipo>

@{
    ViewData["Title"] = "Equipos";

    string? buscar = ViewBag.Buscar;
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int totalRegistros = ViewBag.TotalRegistros;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Equipos</h2>
            <p class="text-muted mb-0">
                Total registrados: @totalRegistros
            </p>
        </div>

        <a asp-controller="Equipos"
           asp-action="Crear"
           class="btn btn-primary">
            Nuevo equipo
        </a>

    </div>

    <div class="card mb-3">

        <div class="card-body">

            <form method="get"
                  asp-controller="Equipos"
                  asp-action="Index">

                <div class="row g-2">

                    <div class="col-md-9">

                        <input type="text"
                               name="buscar"
                               value="@buscar"
                               class="form-control"
                               placeholder="Buscar por cliente, tipo, marca, modelo o número de serie..." />

                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Buscar
                        </button>

                        <a asp-controller="Equipos"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card">

        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No hay equipos registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Tipo</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>N° Serie</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var equipo in Model)
                            {
                                <tr>

                                    <td>
                                        @equipo.Cliente.Nombre
                                        @equipo.Cliente.Apellido
                                    </td>

                                    <td>
                                        @equipo.Tipo
                                    </td>

                                    <td>
                                        @equipo.Marca
                                    </td>

                                    <td>
                                        @equipo.Modelo
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(equipo.NumeroSerie)
                                            ? "-"
                                            : equipo.NumeroSerie)
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Equipos"
                                           asp-action="Editar"
                                           asp-route-id="@equipo.Id"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <form asp-controller="Equipos" asp-action="Eliminar" asp-route-id="@equipo.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('¿Seguro que desea eliminar este equipo?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    @if (totalPaginas > 1)
    {
        <nav class="mt-3">

            <ul class="pagination">

                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Equipos"
                       asp-action="Index"
                       asp-route-buscar="@buscar"
                       asp-route-pagina="@(paginaActual - 1)">
                        Anterior
                    </a>

                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        Página @paginaActual de @totalPaginas
                    </span>
                </li>

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Equipos"
                       asp-action="Index"
                       asp-route-buscar="@buscar"
                       asp-route-pagina="@(paginaActual + 1)">
                        Siguiente
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>